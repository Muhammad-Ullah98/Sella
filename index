<script>
/* Team photo drag-and-drop + click-to-upload, persisted per browser */
(function(){
  var KEY = 'nightowl_team_';
  function safeGet(k){ try { return localStorage.getItem(k); } catch(e){ return null; } }
  function safeSet(k,v){ try { localStorage.setItem(k,v); } catch(e){} }

  document.querySelectorAll('.team-card[data-member]').forEach(function(card){
    var id = card.getAttribute('data-member');
    var avatar = card.querySelector('.team-avatar');
    var input = card.querySelector('.team-photo-input');
    if(!avatar || !input) return;

    function apply(dataUrl){
      avatar.style.backgroundImage = 'url(' + dataUrl + ')';
      avatar.classList.add('has-photo');
    }

    var saved = safeGet(KEY + id);
    if(saved){ apply(saved); }

    function handleFile(file){
      if(!file || file.type.indexOf('image/') !== 0) return;
      var reader = new FileReader();
      reader.onload = function(e){
        apply(e.target.result);
        safeSet(KEY + id, e.target.result);
      };
      reader.readAsDataURL(file);
    }

    input.addEventListener('change', function(){ handleFile(input.files[0]); });

    ['dragenter','dragover'].forEach(function(ev){
      avatar.addEventListener(ev, function(e){ e.preventDefault(); e.stopPropagation(); avatar.classList.add('dragover'); });
    });
    ['dragleave','drop'].forEach(function(ev){
      avatar.addEventListener(ev, function(e){ e.preventDefault(); e.stopPropagation(); avatar.classList.remove('dragover'); });
    });
    avatar.addEventListener('drop', function(e){
      var dt = e.dataTransfer;
      if(dt && dt.files && dt.files.length){ handleFile(dt.files[0]); }
    });
  });
})();
</script>

<script>
/* Scroll-reveal: fade + rise elements as they enter the viewport */
(function(){
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduce || !('IntersectionObserver' in window)) return;

  var groups = [
    '.section-eyebrow', '.section-title', '.section-sub',
    '.problem-card', '.flow-step', '.feature-card',
    '.aud-tile',
    '.pricing-card', '.faq-item', '.team-card',
    '.signup-pitch', '.signup-card',
    '.demo-phone', '.demo-content',
    '.about-mission', '.about-value'
  ];

  var els = [];
  groups.forEach(function(sel){
    var nodes = document.querySelectorAll(sel);
    nodes.forEach(function(n, i){
      n.classList.add('reveal');
      n.style.transitionDelay = Math.min(i * 120, 500) + 'ms';
      els.push(n);
    });
  });

  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if(entry.isIntersecting){
        entry.target.classList.add('in');
        io.unobserve(entry.target);
      }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });

  els.forEach(function(el){ io.observe(el); });
})();
</script>

<script>
/* Nav shadow on scroll + sequential reveal of the demo chat */
(function(){
  var nav = document.querySelector('nav');
  if(nav){
    var onScroll = function(){ nav.classList.toggle('scrolled', window.scrollY > 24); };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var chat = document.querySelector('.demo-chat');
  if(chat){
    var msgs = chat.querySelectorAll('.msg');
    if(reduce || !('IntersectionObserver' in window)){
      msgs.forEach(function(m){ m.classList.add('show'); });
    } else {
      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if(e.isIntersecting){
            msgs.forEach(function(m, i){ setTimeout(function(){ m.classList.add('show'); }, i * 550); });
            io.disconnect();
          }
        });
      }, { threshold: 0.35 });
      io.observe(chat);
    }
  }
})();
</script>

