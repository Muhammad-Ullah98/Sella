<html lang="en"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sella - AI helper for Pakistani sellers</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500;1,9..144,600&family=Inter:wght@300;400;500;600;700&display=swap');

  :root {
    --bg:       #0E1420;
    --bg2:      #151D2C;
    --surface:  #1A2436;
    --border:   #263349;
    --coral:    #F5B841;
    --coral-lt: rgba(245,184,65,0.12);
    --amber:    #6B8AFF;
    --ink:      #EDF1F7;
    --ink2:     #C3CCDA;
    --muted:    #8A97AC;
    --green:    #34D399;
  }

  *{margin:0;padding:0;box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{
    background:var(--bg);
    color:var(--ink);
    font-family:'Inter',-apple-system,sans-serif;
    font-size:16px;
    line-height:1.6;
    overflow-x:hidden;
  }

  /* ── NAV ── */
  nav{
    position:fixed;top:0;left:0;right:0;z-index:100;
    display:flex;align-items:center;justify-content:space-between;
    padding:18px 6%;
    background:rgba(14,20,32,0.82);
    backdrop-filter:blur(14px);
    border-bottom:1px solid var(--border);
  }
  .logo{display:flex;align-items:center;gap:10px;text-decoration:none}
  .logo-mark{
    width:36px;height:36px;border-radius:11px;
    background:linear-gradient(140deg,#F7C25A,#E8912A);
    display:flex;align-items:center;justify-content:center;
    color:var(--bg);
    box-shadow:0 4px 14px rgba(245,184,65,0.28);
  }
  .logo-name .owl-accent{color:var(--coral)}
  .logo-name{font-size:18px;font-weight:700;color:var(--ink);letter-spacing:-.3px}
  .nav-links{display:flex;align-items:center;gap:32px}
  .nav-links a{color:var(--muted);text-decoration:none;font-size:14px;font-weight:500;transition:color .2s}
  .nav-links a:hover{color:var(--ink)}
  .nav-cta{
    background:var(--ink);color:var(--bg);
    padding:10px 22px;border-radius:8px;font-size:14px;
    font-weight:600;text-decoration:none;transition:opacity .2s;
  }
  .nav-cta:hover{opacity:.85}

  /* ── HERO ── */
  .hero{
    min-height:100vh;
    display:flex;flex-direction:column;align-items:center;justify-content:center;
    text-align:center;
    padding:140px 6% 100px;
    position:relative;overflow:hidden;
  }
  /* Gradient blobs like Siena */
  .hero::before{
    content:'';position:absolute;inset:0;
    background:
      radial-gradient(ellipse 55% 55% at 15% 60%, rgba(245,184,65,0.22), transparent 70%),
      radial-gradient(ellipse 50% 50% at 85% 25%, rgba(130,160,220,0.20), transparent 70%),
      radial-gradient(ellipse 40% 40% at 50% 90%, rgba(240,165,0,0.14), transparent 70%);
    pointer-events:none;
  }
  .hero-eyebrow{
    display:inline-flex;align-items:center;gap:8px;
    background:rgba(245,184,65,0.12);border:1px solid rgba(245,184,65,0.25);
    padding:6px 16px;border-radius:999px;
    font-size:12px;font-weight:600;color:var(--coral);
    text-transform:uppercase;letter-spacing:.07em;margin-bottom:32px;
    position:relative;
  }
  .live-dot{width:6px;height:6px;border-radius:50%;background:var(--coral);animation:pulse 1.5s infinite}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
  .hero h1{
    font-family:'Fraunces',Georgia,serif;
    font-size:clamp(44px,7vw,86px);
    font-weight:700;
    line-height:1.05;
    letter-spacing:-.02em;
    max-width:860px;
    margin-bottom:24px;
    position:relative;
    color:var(--ink);
  }
  .hero h1 em{font-style:italic;color:var(--coral)}
  .hero-sub{
    font-size:clamp(16px,2vw,19px);
    color:var(--muted);max-width:520px;
    margin-bottom:44px;line-height:1.7;
    position:relative;
  }
  .hero-sub b{color:var(--ink2)}
  .hero-actions{display:flex;gap:12px;flex-wrap:wrap;justify-content:center;margin-bottom:70px;position:relative}
  .btn-primary{
    background:var(--ink);color:var(--bg);
    padding:15px 30px;border-radius:10px;font-size:15px;
    font-weight:600;text-decoration:none;transition:transform .2s,opacity .2s;display:inline-block;
  }
  .btn-primary:hover{transform:translateY(-2px);opacity:.9}
  .btn-ghost{
    background:transparent;color:var(--ink);
    border:1.5px solid var(--border);
    padding:15px 30px;border-radius:10px;font-size:15px;
    font-weight:500;text-decoration:none;transition:border-color .2s;display:inline-block;
  }
  .btn-ghost:hover{border-color:var(--ink)}
  .stats-strip{
    display:flex;justify-content:center;
    border:1.5px solid var(--border);border-radius:16px;
    overflow:hidden;max-width:680px;width:100%;
    background:rgba(255,255,255,0.04);backdrop-filter:blur(8px);
    position:relative;
  }
  .stat-item{flex:1;padding:22px 20px;text-align:center;border-right:1.5px solid var(--border)}
  .stat-item:last-child{border-right:none}
  .stat-n{font-family:'Fraunces',serif;font-size:30px;font-weight:700;color:var(--ink);display:block}
  .stat-l{font-size:12px;color:var(--muted);margin-top:3px}

  /* ── COMMON ── */
  section{padding:100px 6%}
  .section-eyebrow{
    font-size:11px;font-weight:700;letter-spacing:.1em;
    text-transform:uppercase;color:var(--coral);margin-bottom:14px;
  }
  .section-title{
    font-family:'Fraunces',serif;
    font-size:clamp(30px,4vw,50px);font-weight:700;
    letter-spacing:-.02em;line-height:1.15;margin-bottom:16px;color:var(--ink);
  }
  .section-sub{font-size:17px;color:var(--muted);max-width:540px;line-height:1.65}
  .centered{text-align:center}
  .centered .section-sub{margin:0 auto}

  /* ── PROBLEM ── */
  .problem{background:var(--surface)}
  .problem-grid{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
    gap:1.5px;margin-top:56px;border-radius:16px;overflow:hidden;
    border:1.5px solid var(--border);
  }
  .problem-card{background:var(--bg);padding:36px 28px}
  .problem-icon{font-size:28px;margin-bottom:16px;display:block}
  .problem-title{font-size:16px;font-weight:700;margin-bottom:8px;color:var(--ink)}
  .problem-desc{font-size:14px;color:var(--muted);line-height:1.65}

  /* ── HOW ── */
  .how{background:var(--bg)}
  .flow-wrap{
    display:flex;align-items:stretch;gap:0;
    margin-top:56px;flex-wrap:wrap;justify-content:center;
  }
  .flow-step{
    background:var(--surface);border:1.5px solid var(--border);
    border-radius:16px;padding:32px 24px;text-align:center;
    width:190px;flex-shrink:0;
    transition:transform .25s ease,border-color .25s ease,box-shadow .25s ease;
  }
  .flow-step:hover{transform:translateY(-5px);border-color:var(--coral);box-shadow:0 12px 30px rgba(0,0,0,0.28)}
  .flow-step-num{
    width:38px;height:38px;border-radius:50%;
    background:var(--ink);
    display:flex;align-items:center;justify-content:center;
    font-size:14px;font-weight:700;color:var(--bg);
    margin:0 auto 16px;
  }
  .flow-step-title{font-size:14px;font-weight:700;margin-bottom:6px;color:var(--ink)}
  .flow-step-desc{font-size:12px;color:var(--muted);line-height:1.55}
  .flow-arrow{color:var(--border);font-size:22px;padding:0 12px;flex-shrink:0;align-self:center}

  /* ── FEATURES ── */
  .features{background:var(--surface)}
  .features-grid{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(290px,1fr));
    gap:1.5px;margin-top:56px;border-radius:16px;overflow:hidden;
    border:1.5px solid var(--border);
  }
  .feature-card{background:var(--bg);padding:36px 30px;transition:background .2s}
  .feature-card:hover{background:#202B40}
  .feature-icon{
    width:46px;height:46px;border-radius:12px;
    background:var(--coral-lt);border:1px solid rgba(245,184,65,.2);
    display:flex;align-items:center;justify-content:center;
    font-size:20px;margin-bottom:18px;
  }
  .feature-title{font-size:17px;font-weight:700;margin-bottom:8px;color:var(--ink)}
  .feature-desc{font-size:14px;color:var(--muted);line-height:1.65}

  /* ── DEMO ── */
  .demo-section{background:var(--bg)}
  .demo-wrap{
    display:grid;grid-template-columns:1fr 1fr;
    gap:70px;align-items:center;margin-top:56px;
  }
  .demo-phone{
    background:#111;border-radius:36px;padding:10px;
    box-shadow:0 40px 100px rgba(26,22,18,0.18),0 8px 24px rgba(26,22,18,0.10);
  }
  .demo-screen{background:#0b141a;border-radius:28px;overflow:hidden}
  .demo-header{background:#1f2c33;padding:14px 16px;display:flex;align-items:center;gap:10px}
  .demo-avatar{width:34px;height:34px;border-radius:50%;background:#25D366;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:#0b141a}
  .demo-name{font-size:13px;font-weight:600;color:#e9edef}
  .demo-status{font-size:11px;color:#25D366}
  .demo-chat{padding:16px;display:flex;flex-direction:column;gap:10px}
  .msg{padding:10px 13px;border-radius:8px;font-size:13px;line-height:1.5;max-width:82%}
  .msg-in{background:#1f2c33;color:#e9edef;align-self:flex-start;border-top-left-radius:2px}
  .msg-out{background:#005c4b;color:#e9edef;align-self:flex-end;border-top-right-radius:2px}
  .msg-time{font-size:10px;color:#8696a0;margin-top:3px;text-align:right}
  .demo-content h3{
    font-family:'Fraunces',serif;
    font-size:32px;font-weight:700;margin-bottom:16px;
    letter-spacing:-.01em;line-height:1.2;color:var(--ink);
  }
  .demo-content p{color:var(--muted);font-size:16px;line-height:1.75;margin-bottom:20px}
  .demo-check{display:flex;align-items:center;gap:10px;margin-bottom:12px;font-size:14px;color:var(--ink2)}
  .check-icon{color:var(--green);font-size:15px;font-weight:700;flex-shrink:0}

  /* ── SIGN UP / LEAD MAGNET ── */
  .signup{background:var(--surface)}
  .signup-wrap{
    display:grid;grid-template-columns:1.05fr .95fr;gap:60px;align-items:center;
    max-width:1000px;margin:0 auto;
  }
  .signup-title{
    font-family:'Fraunces',serif;font-size:clamp(30px,4vw,46px);font-weight:700;
    letter-spacing:-.02em;line-height:1.12;margin:14px 0 18px;color:var(--ink);
  }
  .signup-lead{font-size:16px;color:var(--muted);line-height:1.7;margin-bottom:26px}
  .signup-lead b{color:var(--ink2)}
  .signup-benefits{display:flex;flex-direction:column;gap:12px;margin-bottom:24px}
  .signup-benefit{display:flex;align-items:flex-start;gap:10px;font-size:14px;color:var(--ink2)}
  .signup-benefit .sb-ic{color:var(--green);font-weight:700;flex-shrink:0}
  .signup-scarcity{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:var(--coral)}
  .signup-card{
    background:var(--bg);border:1.5px solid var(--border);
    border-radius:20px;padding:32px 30px;
    box-shadow:0 20px 60px rgba(0,0,0,0.25);
  }
  .signup-card-title{font-size:19px;font-weight:700;color:var(--ink);margin-bottom:4px}
  .signup-card-sub{font-size:13px;color:var(--muted);line-height:1.55;margin-bottom:22px}
  .signup-field{margin-bottom:15px}
  .signup-field label{display:block;font-size:12px;font-weight:600;color:var(--ink2);margin-bottom:6px}
  .signup-field input,.signup-field select{
    width:100%;padding:12px 14px;border-radius:10px;
    border:1.5px solid var(--border);background:var(--surface);
    color:var(--ink);font-family:'Inter',sans-serif;font-size:14px;transition:border-color .2s;
  }
  .signup-field input::placeholder{color:var(--muted)}
  .signup-field input:focus,.signup-field select:focus{outline:none;border-color:var(--coral)}
  .signup-field select{cursor:pointer}
  .signup-btn{
    width:100%;padding:14px;border-radius:11px;font-size:15px;font-weight:700;
    cursor:pointer;border:none;background:var(--coral);color:#12181f;
    margin-top:8px;transition:transform .2s,opacity .2s;
  }
  .signup-btn:hover{transform:translateY(-2px);opacity:.92}
  .signup-note{font-size:12px;color:var(--muted);text-align:center;margin-top:12px}
  .signup-note.error{color:#F0997B}
  .signup-success{text-align:center;padding:16px 4px}
  .su-check{
    width:56px;height:56px;border-radius:50%;margin:0 auto 16px;
    background:var(--coral);color:#12181f;font-size:26px;font-weight:700;
    display:flex;align-items:center;justify-content:center;
  }
  .su-success-title{font-size:20px;font-weight:700;color:var(--ink);margin-bottom:8px}
  .su-success-text{font-size:14px;color:var(--muted);line-height:1.6;margin-bottom:20px}
  .signup-success .signup-btn{display:block;text-align:center;text-decoration:none}
  @media(max-width:768px){.signup-wrap{grid-template-columns:1fr;gap:34px}}


  /* ── ABOUT ── */
  .about{background:var(--surface)}
  .about-wrap{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:start;margin-top:56px}
  .about-content h3{
    font-family:'Fraunces',serif;
    font-size:32px;font-weight:700;letter-spacing:-.02em;
    margin-bottom:16px;line-height:1.2;color:var(--ink);
  }
  .about-content p{color:var(--muted);font-size:16px;line-height:1.8;margin-bottom:16px}
  .about-content p b{color:var(--ink2)}
  .about-values{display:flex;flex-direction:column;gap:16px;margin-top:28px}
  .about-value{display:flex;align-items:flex-start;gap:14px}
  .about-value-icon{
    width:42px;height:42px;border-radius:11px;flex-shrink:0;
    background:var(--coral-lt);border:1px solid rgba(245,184,65,.2);
    display:flex;align-items:center;justify-content:center;font-size:18px;
  }
  .about-value-text h4{font-size:15px;font-weight:700;margin-bottom:4px;color:var(--ink)}
  .about-value-text p{font-size:13px;color:var(--muted);line-height:1.55;margin:0}
  .team-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .team-card{
    background:var(--bg);border:1.5px solid var(--border);
    border-radius:14px;padding:24px 20px;text-align:center;transition:border-color .2s,box-shadow .2s;
  }
  .team-card:hover{border-color:var(--ink);box-shadow:0 4px 20px rgba(26,22,18,0.07)}
  .team-avatar{
    width:56px;height:56px;border-radius:50%;
    background:var(--ink);
    display:flex;align-items:center;justify-content:center;
    font-size:16px;font-weight:800;color:var(--bg);
    margin:0 auto 14px;
  }
  .team-name{font-size:15px;font-weight:700;color:var(--ink)}
  .team-role{font-size:12px;color:var(--coral);font-weight:600;margin:4px 0 6px}
  .team-bio{font-size:12px;color:var(--muted);line-height:1.5}
  .team-avatar{position:relative;overflow:hidden;cursor:pointer;background-size:cover;background-position:center}
  .team-avatar .team-avatar-hint{
    position:absolute;bottom:-3px;right:-3px;width:18px;height:18px;border-radius:50%;
    background:var(--coral);color:#fff;font-size:13px;line-height:1;
    display:flex;align-items:center;justify-content:center;
    border:2px solid var(--bg);opacity:0;transition:opacity .2s;
  }
  .team-card:hover .team-avatar:not(.has-photo) .team-avatar-hint{opacity:1}
  .team-avatar.dragover{outline:2px dashed var(--coral);outline-offset:3px}
  .team-avatar.has-photo .team-initials,
  .team-avatar.has-photo .team-avatar-hint{display:none}
  .about-mission{
    background:var(--bg);border:1.5px solid var(--border);
    border-radius:16px;padding:28px;margin-top:24px;
    border-left:4px solid var(--coral);
  }
  .about-mission-label{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--coral);margin-bottom:10px}
  .about-mission-text{
    font-family:'Fraunces',serif;
    font-size:17px;line-height:1.7;color:var(--ink2);font-style:italic;
  }

  /* ── FAQ ── */
  .faq{background:var(--bg)}
  .faq-list{max-width:760px;margin:56px auto 0;display:flex;flex-direction:column;gap:12px}
  .faq-item{
    background:var(--surface);border:1.5px solid var(--border);
    border-radius:14px;overflow:hidden;transition:border-color .2s,box-shadow .2s;
  }
  .faq-item[open]{border-color:var(--ink);box-shadow:0 6px 24px rgba(26,22,18,0.07)}
  .faq-q{
    list-style:none;cursor:pointer;padding:22px 26px;
    font-size:16px;font-weight:600;color:var(--ink);
    display:flex;align-items:center;justify-content:space-between;gap:16px;
  }
  .faq-q::-webkit-details-marker{display:none}
  .faq-icon{position:relative;width:20px;height:20px;flex-shrink:0;transition:transform .25s}
  .faq-item[open] .faq-icon{transform:rotate(45deg)}
  .faq-icon::before,.faq-icon::after{content:'';position:absolute;background:var(--coral);border-radius:2px}
  .faq-icon::before{top:9px;left:1px;right:1px;height:2px}
  .faq-icon::after{left:9px;top:1px;bottom:1px;width:2px}
  .faq-a{padding:0 26px 24px;font-size:14px;color:var(--muted);line-height:1.75}
  .faq-a b{color:var(--ink2)}

  /* ── CTA ── */
  .cta-section{
    padding:100px 6%;text-align:center;
    background:#121B2E;
    position:relative;overflow:hidden;
  }
  .cta-section::before{
    content:'';position:absolute;inset:0;
    background:
      radial-gradient(ellipse 50% 80% at 20% 50%, rgba(245,184,65,0.25), transparent 60%),
      radial-gradient(ellipse 40% 60% at 80% 50%, rgba(130,160,220,0.15), transparent 60%);
    pointer-events:none;
  }
  .cta-section .section-eyebrow{color:rgba(245,184,65,.9);position:relative;margin-bottom:20px}
  .cta-section h2{
    font-family:'Fraunces',serif;
    font-size:clamp(34px,5vw,60px);font-weight:700;
    letter-spacing:-.02em;margin-bottom:16px;
    color:#F5F0E8;position:relative;
  }
  .cta-section p{font-size:18px;color:rgba(245,240,232,0.65);margin-bottom:40px;position:relative}
  .cta-btn-light{
    background:var(--coral);color:#12181f;
    padding:15px 30px;border-radius:10px;font-size:15px;
    font-weight:600;text-decoration:none;transition:transform .2s,opacity .2s;display:inline-block;
  }
  .cta-btn-light:hover{transform:translateY(-2px)}
  .cta-btn-outline{
    background:transparent;color:#F5F0E8;
    border:1.5px solid rgba(245,240,232,0.3);
    padding:15px 30px;border-radius:10px;font-size:15px;
    font-weight:500;text-decoration:none;transition:border-color .2s;display:inline-block;
  }
  .cta-btn-outline:hover{border-color:rgba(245,240,232,.7)}

  /* ── FOOTER ── */
  footer{
    background:var(--bg2);border-top:1.5px solid var(--border);
    padding:40px 6%;display:flex;align-items:center;
    justify-content:space-between;flex-wrap:wrap;gap:16px;
  }
  footer p{font-size:13px;color:var(--muted)}
  .footer-links{display:flex;gap:24px}
  .footer-links a{font-size:13px;color:var(--muted);text-decoration:none;transition:color .2s}
  .footer-links a:hover{color:var(--ink)}

  /* ── RESPONSIVE ── */
  @media(max-width:768px){
    .nav-links{display:none}
    .demo-wrap,.about-wrap{grid-template-columns:1fr}
    .flow-arrow{display:none}
    .flow-wrap{gap:12px}
    .flow-step{width:100%}
  }
  /* ── AUDIENCE (who it is for) ── */
  .audience{background:var(--bg)}
  .aud-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;margin-top:56px}
  .aud-tile{
    background:var(--surface);border:1.5px solid var(--border);border-radius:16px;
    padding:28px 26px;min-height:170px;
    transition:transform .25s ease,border-color .25s ease,box-shadow .25s ease;
  }
